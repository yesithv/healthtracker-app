  "glossaryImcName": "IMC (Indice di Massa Corporea)",
  "glossaryImcDefinition": "Misura che mette in relazione peso e altezza per valutare se il peso di una persona è sano. Calcolato dividendo il peso (kg) per il quadrato dell'altezza (m²).",
  "glossaryImcRange": "18,5 – 24,9 kg/m²",
  "glossaryPesoName": "Peso corporeo",
  "glossaryPesoDefinition": "Massa totale del corpo in chilogrammi o libbre, inclusi muscoli, ossa, organi, grasso e acqua.",
  "glossaryPesoRange": "Dipende da altezza e corporatura",
  "glossaryTallaName": "Altezza (Statura)",
  "glossaryTallaDefinition": "Misurazione dell'altezza di una persona dai piedi alla cima della testa, espressa in centimetri o metri.",
  "glossarySistolicaName": "Pressione Sistolica",
  "glossarySistolicaDefinition": "La pressione massima esercitata dal sangue sulle arterie quando il cuore si contrae (batte). È il numero superiore in una lettura della pressione sanguigna.",
  "glossarySistolicaRange": "< 120 mmHg",
  "glossaryDiastolicaName": "Pressione Diastolica",
  "glossaryDiastolicaDefinition": "La pressione minima esercitata dal sangue sulle arterie tra i battiti cardiaci, quando il cuore è a riposo. È il numero inferiore in una lettura della pressione sanguigna.",
  "glossaryDiastolicaRange": "< 80 mmHg",
  "glossaryFcName": "Frequenza Cardiaca",
  "glossaryFcDefinition": "Numero di volte che il cuore batte al minuto (bpm). A riposo, un cuore sano batte regolarmente entro un intervallo specifico.",
  "glossaryFcRange": "60 – 100 bpm a riposo",
  "glossaryColesterolTotalName": "Colesterolo Totale",
  "glossaryColesterolTotalDefinition": "Somma di tutto il colesterolo presente nel sangue, inclusi LDL, HDL e altri lipidi. È un marcatore generale del rischio cardiovascolare.",
  "glossaryColesterolTotalRange": "< 200 mg/dL",
  "glossaryLdlName": "LDL (Colesterolo \"Cattivo\")",
  "glossaryLdlDefinition": "Lipoproteina a bassa densità. Trasporta il colesterolo nelle arterie e può accumularsi nelle loro pareti, aumentando il rischio di malattie cardiovascolari.",
  "glossaryLdlRange": "< 100 mg/dL",
  "glossaryHdlName": "HDL (Colesterolo \"Buono\")",
  "glossaryHdlDefinition": "Lipoproteina ad alta densità. Raccoglie il colesterolo in eccesso dalle arterie e lo porta al fegato per l'eliminazione. Livelli alti sono protettivi.",
  "glossaryHdlRange": "≥ 60 mg/dL",
  "glossaryVldlName": "VLDL",
  "glossaryVldlDefinition": "Lipoproteina a densità molto bassa. Trasporta i trigliceridi dal fegato ai tessuti. Livelli elevati sono associati a un maggiore rischio cardiovascolare.",
  "glossaryVldlRange": "2 – 30 mg/dL",
  "glossaryTrigliceridosName": "Trigliceridi",
  "glossaryTrigliceridosDefinition": "Un tipo di grasso (lipide) nel sangue. Il corpo li usa come fonte di energia, ma livelli alti aumentano il rischio di malattie cardiache e pancreatiche.",
  "glossaryTrigliceridosRange": "< 150 mg/dL",
  "glossaryGrasaName": "Percentuale di Grasso Corporeo",
  "glossaryGrasaDefinition": "Proporzione di massa grassa rispetto al peso corporeo totale. Include grasso essenziale e grasso di riserva.",
  "glossaryGrasaRange": "Uomini: 8–19% / Donne: 21–33%",
  "glossaryMusculoName": "Massa Muscolare",
  "glossaryMusculoDefinition": "Peso totale del tessuto muscolare nel corpo, espresso in chilogrammi. Una percentuale muscolare più alta è associata a un metabolismo più attivo.",
  "glossaryGrasaVisceralName": "Grasso Viscerale",
  "glossaryGrasaVisceralDefinition": "Grasso accumulato attorno agli organi interni dell'addome (fegato, intestino, pancreas). Livelli alti sono associati a un maggiore rischio metabolico e cardiovascolare.",
  "glossaryGrasaVisceralRange": "Livello 1–9 (sano)",
  "glossaryEdadMetabolicaName": "Età Metabolica",
  "glossaryEdadMetabolicaDefinition": "Età stimata del metabolismo basale rispetto alla media della popolazione. Un'età metabolica inferiore all'età cronologica indica un metabolismo efficiente.",
  "glossaryBmrName": "BMR / Metabolismo Basale (kcal)",
  "glossaryBmrDefinition": "Quantità minima di energia (calorie) di cui il corpo ha bisogno a riposo assoluto per mantenere le funzioni vitali: respirazione, circolazione, temperatura, ecc.",
  "glossaryAguaName": "Acqua Corporea",
  "glossaryAguaDefinition": "Percentuale del peso corporeo corrispondente all'acqua. L'acqua è essenziale per tutte le funzioni cellulari, la regolazione della temperatura e il trasporto di nutrienti.",
  "glossaryAguaRange": "50 – 65%",
  "glossaryHuesoName": "Massa Ossea",
  "glossaryHuesoDefinition": "Peso stimato del tessuto osseo nel corpo. Mantenere una massa ossea adeguata è fondamentale per prevenire l'osteoporosi.",
  "glossaryHuesoRange": "2 – 4 kg (adulto medio)",
