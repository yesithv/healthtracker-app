  "glossaryImcName": "BMI (Body-Mass-Index)",
  "glossaryImcDefinition": "Ein Maß, das Gewicht und Körpergröße in Beziehung setzt, um zu beurteilen, ob das Gewicht einer Person gesund ist. Berechnet durch Division des Gewichts (kg) durch das Quadrat der Körpergröße (m²).",
  "glossaryImcRange": "18,5 – 24,9 kg/m²",
  "glossaryPesoName": "Körpergewicht",
  "glossaryPesoDefinition": "Gesamtmasse des Körpers in Kilogramm oder Pfund, einschließlich Muskeln, Knochen, Organe, Fett und Wasser.",
  "glossaryPesoRange": "Abhängig von Körpergröße und Statur",
  "glossaryTallaName": "Körpergröße",
  "glossaryTallaDefinition": "Maß der Körpergröße einer Person von den Füßen bis zum Scheitelpunkt, ausgedrückt in Zentimetern oder Metern.",
  "glossarySistolicaName": "Systolischer Druck",
  "glossarySistolicaDefinition": "Der maximale Druck, den das Blut auf die Arterien ausübt, wenn das Herz sich zusammenzieht (schlägt). Es ist die obere Zahl bei einer Blutdruckmessung.",
  "glossarySistolicaRange": "< 120 mmHg",
  "glossaryDiastolicaName": "Diastolischer Druck",
  "glossaryDiastolicaDefinition": "Der minimale Druck, den das Blut auf die Arterien zwischen den Herzschlägen ausübt, wenn das Herz in Ruhe ist. Es ist die untere Zahl bei einer Blutdruckmessung.",
  "glossaryDiastolicaRange": "< 80 mmHg",
  "glossaryFcName": "Herzfrequenz",
  "glossaryFcDefinition": "Anzahl der Herzschläge pro Minute (bpm). In Ruhe schlägt ein gesundes Herz regelmäßig innerhalb eines bestimmten Bereichs.",
  "glossaryFcRange": "60 – 100 Schläge/min in Ruhe",
  "glossaryColesterolTotalName": "Gesamtcholesterin",
  "glossaryColesterolTotalDefinition": "Summe aller Cholesterinwerte im Blut, einschließlich LDL, HDL und anderen Lipiden. Allgemeiner Marker für kardiovaskuläres Risiko.",
  "glossaryColesterolTotalRange": "< 200 mg/dL",
  "glossaryLdlName": "LDL (\"Schlechtes\" Cholesterin)",
  "glossaryLdlDefinition": "Lipoprotein niedriger Dichte. Transportiert Cholesterin in die Arterien und kann sich in deren Wänden ansammeln, was das Herzerkrankungsrisiko erhöht.",
  "glossaryLdlRange": "< 100 mg/dL",
  "glossaryHdlName": "HDL (\"Gutes\" Cholesterin)",
  "glossaryHdlDefinition": "Lipoprotein hoher Dichte. Sammelt überschüssiges Cholesterin aus den Arterien und transportiert es zur Leber. Hohe Werte sind schützend.",
  "glossaryHdlRange": "≥ 60 mg/dL",
  "glossaryVldlName": "VLDL",
  "glossaryVldlDefinition": "Lipoprotein sehr niedriger Dichte. Transportiert Triglyceride von der Leber zu den Geweben. Erhöhte Werte sind mit höherem kardiovaskulärem Risiko verbunden.",
  "glossaryVldlRange": "2 – 30 mg/dL",
  "glossaryTrigliceridosName": "Triglyceride",
  "glossaryTrigliceridosDefinition": "Eine Art Fett (Lipid) im Blut. Der Körper nutzt sie als Energiequelle, aber hohe Werte erhöhen das Risiko von Herz- und Bauchspeicheldrüsenerkrankungen.",
  "glossaryTrigliceridosRange": "< 150 mg/dL",
  "glossaryGrasaName": "Körperfettanteil",
  "glossaryGrasaDefinition": "Anteil der Fettmasse am Gesamtkörpergewicht. Umfasst essenzielles Fett (für lebenswichtige Funktionen) und Reservefett.",
  "glossaryGrasaRange": "Männer: 8–19% / Frauen: 21–33%",
  "glossaryMusculoName": "Muskelmasse",
  "glossaryMusculoDefinition": "Gesamtgewicht des Muskelgewebes im Körper in Kilogramm. Ein höherer Muskelanteil ist mit einem aktiveren Stoffwechsel verbunden.",
  "glossaryGrasaVisceralName": "Viszeralfett",
  "glossaryGrasaVisceralDefinition": "Fett, das sich um die inneren Bauchorgane (Leber, Darm, Bauchspeicheldrüse) ansammelt. Hohe Werte sind mit höherem metabolischem und kardiovaskulärem Risiko verbunden.",
  "glossaryGrasaVisceralRange": "Niveau 1–9 (gesund)",
  "glossaryEdadMetabolicaName": "Metabolisches Alter",
  "glossaryEdadMetabolicaDefinition": "Geschätztes Alter des Grundumsatzes im Vergleich zum Bevölkerungsdurchschnitt. Ein metabolisches Alter unter dem chronologischen Alter zeigt einen effizienten Stoffwechsel.",
  "glossaryBmrName": "Grundumsatz / BMR (kcal)",
  "glossaryBmrDefinition": "Mindestmenge an Energie (Kalorien), die der Körper in vollständiger Ruhe zur Aufrechterhaltung der Lebensfunktionen benötigt: Atmung, Kreislauf, Temperatur usw.",
  "glossaryAguaName": "Körperwasser",
  "glossaryAguaDefinition": "Anteil des Körpergewichts, der Wasser entspricht. Wasser ist für alle Zellfunktionen, Temperaturregulierung und Nährstofftransport unerlässlich.",
  "glossaryAguaRange": "50 – 65%",
  "glossaryHuesoName": "Knochenmasse",
  "glossaryHuesoDefinition": "Geschätztes Gewicht des Knochengewebes im Körper. Die Aufrechterhaltung einer ausreichenden Knochenmasse ist wichtig, um Osteoporose vorzubeugen.",
  "glossaryHuesoRange": "2 – 4 kg (Durchschnittserwachsener)",
