  "glossaryImcName": "BMI (Body Mass Index)",
  "glossaryImcDefinition": "A measure relating weight and height to assess whether a person's weight is healthy. Calculated by dividing weight (kg) by height squared (m²).",
  "glossaryImcRange": "18.5 – 24.9 kg/m²",
  "glossaryPesoName": "Body Weight",
  "glossaryPesoDefinition": "Total mass of the body expressed in kilograms or pounds. Includes muscles, bones, organs, fat, and water.",
  "glossaryPesoRange": "Depends on height and build",
  "glossaryTallaName": "Height (Stature)",
  "glossaryTallaDefinition": "Measurement of a person's height from feet to the top of the head, expressed in centimeters or meters.",
  "glossarySistolicaName": "Systolic Pressure",
  "glossarySistolicaDefinition": "The maximum pressure exerted by blood on the arteries when the heart contracts (beats). It is the upper number in a blood pressure reading.",
  "glossarySistolicaRange": "< 120 mmHg",
  "glossaryDiastolicaName": "Diastolic Pressure",
  "glossaryDiastolicaDefinition": "The minimum pressure exerted by blood on the arteries between heartbeats, when the heart is at rest. It is the lower number in a blood pressure reading.",
  "glossaryDiastolicaRange": "< 80 mmHg",
  "glossaryFcName": "Heart Rate",
  "glossaryFcDefinition": "Number of times the heart beats per minute (bpm). At rest, a healthy heart beats regularly within a specific range.",
  "glossaryFcRange": "60 – 100 bpm at rest",
  "glossaryColesterolTotalName": "Total Cholesterol",
  "glossaryColesterolTotalDefinition": "Sum of all cholesterol in the blood, including LDL, HDL, and other lipids. It is a general marker of cardiovascular risk.",
  "glossaryColesterolTotalRange": "< 200 mg/dL",
  "glossaryLdlName": "LDL (\"Bad\" Cholesterol)",
  "glossaryLdlDefinition": "Low-density lipoprotein. It carries cholesterol into the arteries and can accumulate in their walls, increasing cardiovascular disease risk.",
  "glossaryLdlRange": "< 100 mg/dL",
  "glossaryHdlName": "HDL (\"Good\" Cholesterol)",
  "glossaryHdlDefinition": "High-density lipoprotein. It collects excess cholesterol from the arteries and carries it to the liver for elimination. High levels are protective.",
  "glossaryHdlRange": "≥ 60 mg/dL",
  "glossaryVldlName": "VLDL",
  "glossaryVldlDefinition": "Very low-density lipoprotein. It transports triglycerides from the liver to tissues. Elevated levels are associated with higher cardiovascular risk.",
  "glossaryVldlRange": "2 – 30 mg/dL",
  "glossaryTrigliceridosName": "Triglycerides",
  "glossaryTrigliceridosDefinition": "A type of fat (lipid) in the blood. The body uses them as an energy source, but high levels increase the risk of heart and pancreatic disease.",
  "glossaryTrigliceridosRange": "< 150 mg/dL",
  "glossaryGrasaName": "Body Fat Percentage",
  "glossaryGrasaDefinition": "Proportion of fat mass relative to total body weight. Includes essential fat (needed for vital functions) and storage fat.",
  "glossaryGrasaRange": "Men: 8–19% / Women: 21–33%",
  "glossaryMusculoName": "Muscle Mass",
  "glossaryMusculoDefinition": "Total weight of muscle tissue in the body, expressed in kilograms. A higher muscle percentage is associated with a more active metabolism.",
  "glossaryGrasaVisceralName": "Visceral Fat",
  "glossaryGrasaVisceralDefinition": "Fat accumulated around the internal organs of the abdomen (liver, intestines, pancreas). High levels are associated with higher metabolic and cardiovascular risk.",
  "glossaryGrasaVisceralRange": "Level 1–9 (healthy)",
  "glossaryEdadMetabolicaName": "Metabolic Age",
  "glossaryEdadMetabolicaDefinition": "Estimated age of basal metabolism compared to the population average. A metabolic age lower than chronological age indicates an efficient metabolism.",
  "glossaryBmrName": "BMR / Basal Metabolism (kcal)",
  "glossaryBmrDefinition": "Minimum amount of energy (calories) the body needs at complete rest to maintain vital functions: breathing, circulation, temperature, etc.",
  "glossaryAguaName": "Body Water",
  "glossaryAguaDefinition": "Percentage of body weight that corresponds to water. Water is essential for all cellular functions, temperature regulation, and nutrient transport.",
  "glossaryAguaRange": "50 – 65%",
  "glossaryHuesoName": "Bone Mass",
  "glossaryHuesoDefinition": "Estimated weight of bone tissue in the body. Maintaining adequate bone mass is essential to prevent osteoporosis.",
  "glossaryHuesoRange": "2 – 4 kg (average adult)",
