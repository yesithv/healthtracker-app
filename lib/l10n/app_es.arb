  "glossaryImcName": "IMC (Índice de Masa Corporal)",
  "glossaryImcDefinition": "Medida que relaciona el peso y la talla de una persona para evaluar si su peso es saludable. Se calcula dividiendo el peso (kg) entre la talla al cuadrado (m²).",
  "glossaryImcRange": "18.5 – 24.9 kg/m²",
  "glossaryPesoName": "Peso corporal",
  "glossaryPesoDefinition": "Masa total del cuerpo expresada en kilogramos o libras. Incluye músculos, huesos, órganos, grasa y agua.",
  "glossaryPesoRange": "Depende de la talla y complexión",
  "glossaryTallaName": "Talla (Estatura)",
  "glossaryTallaDefinition": "Medida de la altura de una persona desde los pies hasta la parte superior de la cabeza, expresada en centímetros o metros.",
  "glossarySistolicaName": "Presión Sistólica",
  "glossarySistolicaDefinition": "Es la presión máxima que ejerce la sangre sobre las arterias cuando el corazón se contrae (late). Es el número superior en una lectura de presión arterial.",
  "glossarySistolicaRange": "< 120 mmHg",
  "glossaryDiastolicaName": "Presión Diastólica",
  "glossaryDiastolicaDefinition": "Es la presión mínima que ejerce la sangre sobre las arterias entre latidos, cuando el corazón está en reposo. Es el número inferior en una lectura de presión arterial.",
  "glossaryDiastolicaRange": "< 80 mmHg",
  "glossaryFcName": "Frecuencia Cardíaca",
  "glossaryFcDefinition": "Número de veces que el corazón late por minuto (lpm). En reposo, un corazón saludable late de forma regular y en un rango específico.",
  "glossaryFcRange": "60 – 100 lpm en reposo",
  "glossaryColesterolTotalName": "Colesterol Total",
  "glossaryColesterolTotalDefinition": "Suma de todo el colesterol presente en la sangre, incluyendo LDL, HDL y otros lípidos. Es un marcador general del riesgo cardiovascular.",
  "glossaryColesterolTotalRange": "< 200 mg/dL",
  "glossaryLdlName": "LDL (Colesterol \"Malo\")",
  "glossaryLdlDefinition": "Lipoproteína de baja densidad. Transporta colesterol al interior de las arterias y puede acumularse en sus paredes, aumentando el riesgo de enfermedad cardiovascular.",
  "glossaryLdlRange": "< 100 mg/dL",
  "glossaryHdlName": "HDL (Colesterol \"Bueno\")",
  "glossaryHdlDefinition": "Lipoproteína de alta densidad. Recoge el colesterol sobrante de las arterias y lo lleva al hígado para ser eliminado. Niveles altos son protectores.",
  "glossaryHdlRange": "≥ 60 mg/dL",
  "glossaryVldlName": "VLDL",
  "glossaryVldlDefinition": "Lipoproteína de muy baja densidad. Transporta triglicéridos desde el hígado hacia los tejidos. Niveles elevados se asocian con mayor riesgo cardiovascular.",
  "glossaryVldlRange": "2 – 30 mg/dL",
  "glossaryTrigliceridosName": "Triglicéridos",
  "glossaryTrigliceridosDefinition": "Tipo de grasa (lípido) presente en la sangre. El cuerpo los usa como fuente de energía, pero niveles altos aumentan el riesgo de enfermedades cardíacas y pancreáticas.",
  "glossaryTrigliceridosRange": "< 150 mg/dL",
  "glossaryGrasaName": "Porcentaje de Grasa Corporal",
  "glossaryGrasaDefinition": "Proporción de masa grasa respecto al peso total del cuerpo. Incluye grasa esencial (necesaria para funciones vitales) y grasa de reserva.",
  "glossaryGrasaRange": "Hombres: 8–19% / Mujeres: 21–33%",
  "glossaryMusculoName": "Masa Muscular",
  "glossaryMusculoDefinition": "Peso total del tejido muscular en el cuerpo, expresado en kilogramos. Un mayor porcentaje de músculo se asocia con un metabolismo más activo.",
  "glossaryGrasaVisceralName": "Grasa Visceral",
  "glossaryGrasaVisceralDefinition": "Grasa acumulada alrededor de los órganos internos del abdomen (hígado, intestinos, páncreas). Niveles altos están asociados a mayor riesgo metabólico y cardiovascular.",
  "glossaryGrasaVisceralRange": "Nivel 1–9 (saludable)",
  "glossaryEdadMetabolicaName": "Edad Metabólica",
  "glossaryEdadMetabolicaDefinition": "Edad estimada del metabolismo basal comparado con la media de la población. Una edad metabólica menor a la cronológica indica un metabolismo eficiente.",
  "glossaryBmrName": "BMR / Metabolismo Basal (kcal)",
  "glossaryBmrDefinition": "Cantidad mínima de energía (calorías) que el cuerpo necesita en reposo absoluto para mantener las funciones vitales: respiración, circulación, temperatura, etc.",
  "glossaryAguaName": "Agua Corporal",
  "glossaryAguaDefinition": "Porcentaje del peso corporal que corresponde al agua. El agua es esencial para todas las funciones celulares, regulación de temperatura y transporte de nutrientes.",
  "glossaryAguaRange": "50 – 65%",
  "glossaryHuesoName": "Masa Ósea",
  "glossaryHuesoDefinition": "Peso estimado del tejido óseo en el cuerpo. Mantener una masa ósea adecuada es fundamental para prevenir la osteoporosis.",
  "glossaryHuesoRange": "2 – 4 kg (adulto promedio)",
