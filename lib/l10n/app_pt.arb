  "glossaryImcName": "IMC (Índice de Massa Corporal)",
  "glossaryImcDefinition": "Medida que relaciona peso e altura para avaliar se o peso de uma pessoa é saudável. Calculado dividindo o peso (kg) pela altura ao quadrado (m²).",
  "glossaryImcRange": "18,5 – 24,9 kg/m²",
  "glossaryPesoName": "Peso corporal",
  "glossaryPesoDefinition": "Massa total do corpo em quilogramas ou libras, incluindo músculos, ossos, órgãos, gordura e água.",
  "glossaryPesoRange": "Depende da altura e compleição",
  "glossaryTallaName": "Altura (Estatura)",
  "glossaryTallaDefinition": "Medida da altura de uma pessoa dos pés ao topo da cabeça, expressa em centímetros ou metros.",
  "glossarySistolicaName": "Pressão Sistólica",
  "glossarySistolicaDefinition": "A pressão máxima exercida pelo sangue sobre as artérias quando o coração se contrai (bate). É o número superior em uma leitura de pressão arterial.",
  "glossarySistolicaRange": "< 120 mmHg",
  "glossaryDiastolicaName": "Pressão Diastólica",
  "glossaryDiastolicaDefinition": "A pressão mínima exercida pelo sangue sobre as artérias entre os batimentos cardíacos, quando o coração está em repouso. É o número inferior em uma leitura de pressão arterial.",
  "glossaryDiastolicaRange": "< 80 mmHg",
  "glossaryFcName": "Frequência Cardíaca",
  "glossaryFcDefinition": "Número de vezes que o coração bate por minuto (bpm). Em repouso, um coração saudável bate regularmente dentro de um intervalo específico.",
  "glossaryFcRange": "60 – 100 bpm em repouso",
  "glossaryColesterolTotalName": "Colesterol Total",
  "glossaryColesterolTotalDefinition": "Soma de todo o colesterol presente no sangue, incluindo LDL, HDL e outros lipídios. É um marcador geral do risco cardiovascular.",
  "glossaryColesterolTotalRange": "< 200 mg/dL",
  "glossaryLdlName": "LDL (Colesterol \"Ruim\")",
  "glossaryLdlDefinition": "Lipoproteína de baixa densidade. Transporta colesterol para o interior das artérias e pode se acumular em suas paredes, aumentando o risco de doença cardiovascular.",
  "glossaryLdlRange": "< 100 mg/dL",
  "glossaryHdlName": "HDL (Colesterol \"Bom\")",
  "glossaryHdlDefinition": "Lipoproteína de alta densidade. Coleta o excesso de colesterol das artérias e o leva ao fígado para eliminação. Níveis altos são protetores.",
  "glossaryHdlRange": "≥ 60 mg/dL",
  "glossaryVldlName": "VLDL",
  "glossaryVldlDefinition": "Lipoproteína de densidade muito baixa. Transporta triglicerídeos do fígado para os tecidos. Níveis elevados estão associados a maior risco cardiovascular.",
  "glossaryVldlRange": "2 – 30 mg/dL",
  "glossaryTrigliceridosName": "Triglicerídeos",
  "glossaryTrigliceridosDefinition": "Tipo de gordura (lipídio) presente no sangue. O corpo os usa como fonte de energia, mas níveis altos aumentam o risco de doenças cardíacas e pancreáticas.",
  "glossaryTrigliceridosRange": "< 150 mg/dL",
  "glossaryGrasaName": "Percentual de Gordura Corporal",
  "glossaryGrasaDefinition": "Proporção de massa gorda em relação ao peso corporal total. Inclui gordura essencial e gordura de reserva.",
  "glossaryGrasaRange": "Homens: 8–19% / Mulheres: 21–33%",
  "glossaryMusculoName": "Massa Muscular",
  "glossaryMusculoDefinition": "Peso total do tecido muscular no corpo, expresso em quilogramas. Um maior percentual de músculo está associado a um metabolismo mais ativo.",
  "glossaryGrasaVisceralName": "Gordura Visceral",
  "glossaryGrasaVisceralDefinition": "Gordura acumulada ao redor dos órgãos internos do abdome (fígado, intestinos, pâncreas). Níveis altos estão associados a maior risco metabólico e cardiovascular.",
  "glossaryGrasaVisceralRange": "Nível 1–9 (saudável)",
  "glossaryEdadMetabolicaName": "Idade Metabólica",
  "glossaryEdadMetabolicaDefinition": "Idade estimada do metabolismo basal em comparação com a média da população. Uma idade metabólica menor que a cronológica indica um metabolismo eficiente.",
  "glossaryBmrName": "BMR / Metabolismo Basal (kcal)",
  "glossaryBmrDefinition": "Quantidade mínima de energia (calorias) que o corpo precisa em repouso absoluto para manter as funções vitais: respiração, circulação, temperatura, etc.",
  "glossaryAguaName": "Água Corporal",
  "glossaryAguaDefinition": "Percentual do peso corporal correspondente à água. A água é essencial para todas as funções celulares, regulação da temperatura e transporte de nutrientes.",
  "glossaryAguaRange": "50 – 65%",
  "glossaryHuesoName": "Massa Óssea",
  "glossaryHuesoDefinition": "Peso estimado do tecido ósseo no corpo. Manter uma massa óssea adequada é fundamental para prevenir a osteoporose.",
  "glossaryHuesoRange": "2 – 4 kg (adulto médio)",
